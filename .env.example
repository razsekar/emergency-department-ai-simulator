# Copy to .env and edit. Never commit .env. Keys stay server-side.
POSTGRES_USER=edsim
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=edsim
DATABASE_URL=postgresql+psycopg://edsim:change-me-locally@db:5432/edsim
CORS_ORIGINS=["http://localhost:4200"]
LOG_LEVEL=INFO

# LLM providers (configure only those you will use; used from Phase 5)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Identity / auth (required for login). Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=60
# Demo user passwords (users: demo_admin, demo_presenter, demo_viewer). Seed with:
#   docker compose exec backend python -m app.modules.identity.application.seed
DEMO_ADMIN_PASSWORD=
DEMO_PRESENTER_PASSWORD=
DEMO_VIEWER_PASSWORD=

# Optional model lists offered in the UI (comma separated provider model ids; set to ids YOU have verified).
# Nothing is hardcoded in the app. Ollama models are discovered from the running Ollama service.
ANTHROPIC_MODELS=
OPENAI_MODELS=
GEMINI_MODELS=
